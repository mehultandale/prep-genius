# ── Backend ────────────────────────────────────────────────────────────────────
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/prep-genius
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string

# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Concurrency + rate limiting for LLM calls (free-tier friendly)
LLM_MAX_CONCURRENCY=2
LLM_MIN_REQUEST_INTERVAL_MS=4000
LLM_MAX_RETRIES=5

# Crawler politeness
CRAWL_MAX_PAGES=12
CRAWL_DELAY_SECONDS=1.5

# Batch run limits
EVAL_MAX_CASES=50

# ── Scraping helper (used by backend child processes) ─────────────────────────
PYTHON_BIN=python3
SCRAPING_DIR=../scraping

# ── Frontend ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
